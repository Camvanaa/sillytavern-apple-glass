# whitelist approach: only theme/project files are tracked
/*
!/.gitignore
!/apple-theme.css
!/sync-css.sh
!/splash.css
!/compose.yaml
!/data/
/data/*
!/data/default-user/
/data/default-user/*
!/data/default-user/themes/
!/data/default-user/OpenAI Settings/
!/extensions/
/extensions/*
!/extensions/SillyTavern-AppleGlassStyles/
!/tools/
